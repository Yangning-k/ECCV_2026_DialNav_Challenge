# Copy this file to .env and adjust the two required paths.
DIALNAV_PYTHON=/path/to/python
DIALNAV_MATTERPORT_SIM_BUILD=/path/to/Matterport3DSimulator/build

# Optional: preload shared libraries if your Matterport3D build needs them.
# DIALNAV_LD_LIBRARY_PATH=/path/to/lib

# Optional: extra site-packages directory if the chosen Python environment
# does not already expose torch/transformers (leave empty on normal installs).
# DIALNAV_SITE_PACKAGES=/path/to/site-packages
